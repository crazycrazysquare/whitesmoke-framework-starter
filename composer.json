{
    "name": "whitesmoke/framework",
    "description": "Whitesmoke Framework application skeleton.",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "framework",
        "php",
        "whitesmoke"
    ],
    "require": {
        "php": ">=8.3",
        "whitesmoke/core": "^0.2.13"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "test": "phpunit"
    }
}
