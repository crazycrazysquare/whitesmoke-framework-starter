# Copy this file to .env and adjust. Never commit .env.
# Real server environment variables (PHP-FPM pool, Docker) override these values.

APP_URL=http://127.0.0.1:8000   # the site address, used in links in emails
APP_DEBUG=false          # true shows error details; never in production
LOG_LEVEL=info           # debug, info, warning, error

SESSION_SECURE=true      # false only for plain-HTTP local development

STORAGE_PATH=            # empty = storage/; an absolute path puts sessions, logs, cache and uploads elsewhere

TRUSTED_PROXIES=         # your reverse proxy's IPs or CIDR ranges, comma-separated; empty = none

CACHE_DRIVER=file        # file (one server), database (shared; run php smoke migrate) or redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_ENCRYPTION=none    # tls, or none (only for a Redis on this machine)
REDIS_USERNAME=
REDIS_PASSWORD=

DB_CONNECTION=sqlite     # mysql, pgsql, sqlite, sqlsrv
DB_HOST=127.0.0.1
DB_PORT=
DB_DATABASE=             # empty = storage/database.sqlite for SQLite
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=prefer        # PostgreSQL only
DB_TRUST_SERVER_CERTIFICATE=false   # SQL Server only; true only for a self-signed certificate (local, Docker)

MAIL_DRIVER=log          # smtp, or log: write emails to storage/logs/mail-*.log (development only)
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls      # tls (STARTTLS), ssl, or none (only to a server on this machine)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.test
MAIL_FROM_NAME="Whitesmoke"         # quote names with spaces: "My App"
